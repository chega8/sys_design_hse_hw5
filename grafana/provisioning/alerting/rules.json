{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "Скоринг",
      "folder": "Антифрод",
      "interval": "10s",
      "rules": [
        {
          "uid": "fraud-share-high",
          "title": "Доля фрода выше 25%",
          "condition": "B",
          "for": "20s",
          "noDataState": "OK",
          "execErrState": "Error",
          "isPaused": false,
          "annotations": {
            "summary": "За 30 секунд больше четверти транзакций отмечены как фрод."
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 60,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "(sum(rate(fraud_flagged_total[30s])) / (sum(rate(fraud_scored_total[30s])) > 0)) or vector(0)",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.25
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "fraud-stream-stalled",
          "title": "Поток транзакций остановился",
          "condition": "B",
          "for": "20s",
          "noDataState": "OK",
          "execErrState": "Error",
          "isPaused": false,
          "annotations": {
            "summary": "За последние 20 секунд скорость упала ниже 0,1 транзакции/с."
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 60,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "sum(rate(fraud_scored_total[20s])) or vector(0)",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        0.1
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
